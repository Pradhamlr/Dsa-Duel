# Copy to .env and fill in. Never commit the real .env -- it is gitignored.

# ---- Core ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---- Data ----
# PostgreSQL. If you use Supabase, prefer a POOLER connection string:
# the direct host (db.<ref>.supabase.co) is IPv6-only, which fails from any
# IPv4-only network or host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsaduel

# Redis. Used for rate limiting, the access-token denylist, and pending registrations.
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Signs access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Where the frontend lives. Used for post-OAuth redirects.
CLIENT_URL=http://localhost:5173

# Extra CORS origins beyond the built-in allowlist, comma-separated. Optional.
EXTRA_ALLOWED_ORIGINS=

# ---- Google OAuth (optional; email/password works without it) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# ---- In-app judge (optional; everything except Run/Submit works without it) ----
# A self-hosted Judge0 instance: https://github.com/judge0/judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# ---- Email (verification codes, password reset) ----
EMAIL_USER=
EMAIL_PASS=

# ---- Optional services ----
# Groq, used only as a fallback classifier for problems LeetCode tags don't resolve.
GROQ_API_KEY=

# Sentry error tracking. Left empty, Sentry simply no-ops.
SENTRY_DSN=

# Set to any value to skip boot-time jobs (LeetCode catalog sync, AI retry,
# session cleanup). Used by CI and end-to-end runs so tests don't hit LeetCode's API.
DISABLE_BACKGROUND_JOBS=
