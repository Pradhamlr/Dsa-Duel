generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  username  String?  @unique
  password  String?
  name      String?
  googleId  String?  @unique
  authProvider String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  resetToken String?  @unique
  resetTokenExpiry DateTime?
  emailVerified Boolean @default(false)
  verificationToken String? @unique
  verificationTokenExpiry DateTime?
  leetcodeUsername String?

  contests  Contest[] @relation("CreatorContests")
  results   Result[]
  sessions  Session[]
  submissions Submission[]
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash     String    @unique
  previousHash  String?
  rotatedAt     DateTime?
  familyId      String

  userAgent     String?
  ipAddress     String?
  deviceLabel   String?

  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Contest {
  id              String   @id @default(uuid()) // you can use your short id if you prefer
  creatorId       String?
  creator         User?    @relation("CreatorContests", fields: [creatorId], references: [id])
  numProblems     Int
  difficulty      String
  problems        Json
  createdAt       DateTime @default(now())
  startTime       DateTime?
  durationSeconds Int
  results         Result[]
  submissions     Submission[]

  @@index([creatorId])
}

model Result {
  id          Int      @id @default(autoincrement())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  problemIndex Int
  solvedAt    DateTime?
  verifiedVia VerificationSource @default(manual)

  @@unique([contestId, userId, problemIndex])
  @@index([contestId, userId])
}

enum VerificationSource {
  manual
  leetcode
  judge
}

enum TagSource {
  leetcode
  ai
  merged
}

enum AIStatus {
  pending
  completed
  failed
}

model Problem {
  id           String   @id @default(uuid())
  leetcodeId   String   @unique

  title        String
  difficulty   String
  leetcodeUrl  String

  leetcodeTags String[]
  aiTags       String[]
  finalTags    String[]

  tagSource    TagSource
  aiStatus     AIStatus @default(completed)

  aiRetryCount  Int      @default(0)
  lastAiTriedAt DateTime?

  // In-app judge metadata (Phase 2 backfill populates these; all nullable/defaulted
  // so this is purely additive and invisible to any code that doesn't reference them).
  functionSignature Json?    // LeetCode's metaData: {name, params:[{name,type}], return:{type,size}}
  codeSnippets      Json?    // real starter code per language, e.g. {java: "...", cpp: "..."}
  testCases         Json?    // parsed [{input:{...}, output:...}] pairs, examples only
  judgeSupported    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([difficulty])
  @@index([finalTags])
  @@index([judgeSupported])
}

enum SubmissionLanguage {
  java
  cpp
}

enum SubmissionVerdict {
  accepted
  wrong_answer
  compile_error
  runtime_error
  time_limit_exceeded
  pending
}

model Submission {
  id          String   @id @default(uuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  problemIndex Int

  language    SubmissionLanguage
  code        String
  verdict     SubmissionVerdict @default(pending)
  testResults Json?            // [{input, expectedOutput, actualOutput, passed, error?}]

  createdAt   DateTime @default(now())

  @@index([contestId, userId, problemIndex])
}
